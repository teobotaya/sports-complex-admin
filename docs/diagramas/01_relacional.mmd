erDiagram
    CLIENTE {
        int id_cliente PK
        varchar nombre_completo
        varchar telefono UK
        nvarchar observaciones
        date fecha_alta
    }
    USUARIO {
        int id_usuario PK
        varchar nombre_completo
        varchar username UK
        varchar password_hash
        varchar rol
        bit activo
        datetime2 fecha_creacion
    }
    CANCHA {
        int id_cancha PK
        varchar nombre UK
        varchar tipo_superficie
        decimal precio_por_hora
        bit activa
    }
    RESERVA {
        int id_reserva PK
        int id_cliente FK
        int id_cancha FK
        int id_usuario FK
        date fecha
        time hora_inicio
        time hora_fin
        varchar estado_reserva
        varchar estado_pago
        nvarchar observaciones
        datetime2 fecha_creacion
    }
    PAGO {
        int id_pago PK
        int id_reserva FK
        decimal monto
        varchar metodo_pago
        date fecha_pago
        nvarchar observaciones
    }
    CANCELACION {
        int id_cancelacion PK
        int id_reserva FK
        int id_usuario FK
        nvarchar motivo
        datetime2 fecha_cancelacion
    }
    DEVOLUCION {
        int id_devolucion PK
        int id_cancelacion FK
        decimal monto_devuelto
        varchar metodo
        date fecha
        nvarchar observaciones
    }
    NOTIFICACION {
        int id_notificacion PK
        int id_usuario FK
        varchar tipo
        nvarchar mensaje
        bit leida
        datetime2 fecha_creacion
    }
    TORNEO {
        int id_torneo PK
        varchar nombre
        date fecha_inicio
        date fecha_fin
        varchar categoria
        varchar estado
    }
    EQUIPO {
        int id_equipo PK
        int id_torneo FK
        varchar nombre
        varchar contacto_nombre
        varchar contacto_telefono
    }
    INTEGRANTE {
        int id_integrante PK
        int id_equipo FK
        varchar nombre_completo
        varchar dni
    }
    PARTIDO {
        int id_partido PK
        int id_torneo FK
        int id_equipo_local FK
        int id_equipo_visitante FK
        int id_cancha FK
        date fecha
        time hora_inicio
        int goles_local
        int goles_visitante
        varchar estado
    }

