# Copiá este archivo como .env y completá los valores antes de levantar Docker.
#   cp .env.example .env
# El archivo .env está excluido del repositorio: nunca subas credenciales reales.

# Contraseña del usuario sa de SQL Server (mínimo 8 caracteres, con mayúscula,
# minúscula, número y símbolo).
DB_PASSWORD=CambiarEstaPassword123!

# Clave de firma de los tokens JWT. Debe tener al menos 32 caracteres.
# Generar una nueva, por ejemplo con: openssl rand -base64 48
JWT_KEY=CAMBIAR-POR-UNA-CLAVE-ALEATORIA-DE-AL-MENOS-32-CARACTERES

# Usuario administrador que se crea la primera vez que arranca la API.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=CambiarEstaPassword123!
